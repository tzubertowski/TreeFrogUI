diff --git a/src/sf2000_diag.h b/src/sf2000_diag.h
index a677043..3318387 100644
--- a/src/sf2000_diag.h
+++ b/src/sf2000_diag.h
@@ -41,11 +41,40 @@ static inline void diag_add(const char *msg) {
 }
 #endif
 
-#else /* not SF2000 */
+#else /* not SF2000 - picoarch/libretro build: append to the standard
+       * /mnt/sdcard/log.txt, gated on the file already existing (same
+       * on/off convention as the rest of TreeFrogUI's logging) */
 
-#define xlog(...) ((void)0)
-#define DIAG(msg)
-#define DIAG_FATAL(msg)
+#include <stdio.h>
+#include <stdarg.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline void xlog(const char *fmt, ...) {
+    FILE *f = fopen("/mnt/sdcard/log.txt", "r");
+    if (!f) return;
+    fclose(f);
+
+    f = fopen("/mnt/sdcard/log.txt", "a");
+    if (!f) return;
+
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(f, fmt, ap);
+    va_end(ap);
+
+    fflush(f);
+    fclose(f);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#define DIAG(msg) xlog("UAE4ALL: %s\n", msg)
+#define DIAG_FATAL(msg) xlog("UAE4ALL FATAL: %s\n", msg)
 
 #endif /* SF2000 */
 
