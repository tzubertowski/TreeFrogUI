@@ -1105,6 +1112,54 @@ void retro_deinit(void)
 extern char *dcastaway_image_file;
 extern int changed_fdc0;

+#ifdef TREEFROG_CASTAWAY_BACKLIGHT
+static int32_t backlight_level;
+static time_t next_backlight_refresh;
+
+static void init_backlight_refresh(void)
+{
+    struct stat device;
+    backlight_level = 0;
+    if (stat("/dev/backlight", &device) != 0 || !S_ISCHR(device.st_mode))
+        return;
+
+    /* MichaelLuca2020's working raw backlight value (TreeFrogUI issue #51). */
+    backlight_level = 40;
+    next_backlight_refresh = 0;
+    FILE *settings = fopen("/mnt/sdcard/frogui/settings.txt", "r");
+    if (!settings)
+        return;
+
+    char line[128];
+    int brightness;
+    while (fgets(line, sizeof line, settings)) {
+        if (sscanf(line, "brightness=%d", &brightness) == 1 &&
+            brightness >= 0 && brightness <= 100) {
+            /* Match TreeFrogUI's conversion to the display driver's level. */
+            backlight_level = brightness < 43 ? brightness + 23
+                                             : brightness * brightness / 43 + 23;
+            break;
+        }
+    }
+    fclose(settings);
+}
+
+static void refresh_backlight(void)
+{
+    struct timespec now;
+    if (!backlight_level || clock_gettime(CLOCK_MONOTONIC, &now) != 0 ||
+        now.tv_sec < next_backlight_refresh)
+        return;
+
+    next_backlight_refresh = now.tv_sec + 1;
+    int fd = open("/dev/backlight", O_WRONLY);
+    if (fd < 0)
+        return;
+    (void)!write(fd, &backlight_level, sizeof backlight_level);
+    close(fd);
+}
+#endif
