+int fluid_hashtable_lookup(fluid_hashtable_t *hash_table, char* key, void** value, int* type);
+
+/* Returns non-zero if removed, 0 if not removed */
+int fluid_hashtable_remove(fluid_hashtable_t *hash_table, char* key);
