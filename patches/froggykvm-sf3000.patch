+
+  if (synth->verbose) {
+    FLUID_LOG(FLUID_INFO, "cc\t%d\t%d\t%d", chan, num, val);
+  }
+
+  /* set the controller value in the channel */
+  fluid_channel_cc(synth->channel[chan], num, val);
+
+  return FLUID_OK;
+}
