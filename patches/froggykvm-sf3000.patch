+ * new_fluid_defpreset
+ */
+fluid_defpreset_t*
+new_fluid_defpreset(fluid_defsfont_t* sfont)
+{
+  fluid_defpreset_t* preset = FLUID_NEW(fluid_defpreset_t);
+  if (preset == NULL) {
+    FLUID_LOG(FLUID_ERR, "Out of memory");
+    return NULL;
+  }
+  preset->next = NULL;
+  preset->sfont = sfont;
+  preset->name[0] = 0;
+  preset->bank = 0;
+  preset->num = 0;
+  preset->global_zone = NULL;
