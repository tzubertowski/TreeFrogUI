+/* Draw the main menu overlay into fb565. */
+static void menu_draw(void) {
+    const uint16_t BG = 0x10A2, FG = 0xFFFF, HLBG = 0x07E0, HLFG = 0x0000, BORD = 0x4A69;
+    const int x0 = 120, w = 400, y0 = 90, rowh = 30;
+    int x1 = x0 + w, y1 = y0 + MENU_N*rowh + 18;
+    for (int yy = y0 - 30; yy < y1 && yy < 480; yy++)
+        for (int xx = x0 - 14; xx < x1 && xx < 640; xx++) {
+            int edge = (yy==y0-30 || yy==y1-1 || xx==x0-14 || xx==x1-1);
+            fb565[yy*640+xx] = edge ? BORD : BG;
+        }
+    kb_puts(x0, y0 - 24, "PICO286 MENU", FG, BG);
+    for (int i = 0; i < MENU_N; i++) {
+        int y = y0 + i*rowh, sel = (i == menu_sel);
+        uint16_t fg = sel ? HLFG : FG, bg = sel ? HLBG : BG;
+        if (sel) for (int yy = y-2; yy < y+rowh-6 && yy < 480; yy++)
+            for (int xx = x0-8; xx < x1-6 && xx < 640; xx++) fb565[yy*640+xx] = bg;
+        char line[80]; menu_label(i, line, sizeof line);
+        kb_puts(x0, y, line, fg, bg);
+    }
+}
+
+/* Send the currently-highlighted key (with shift/ctrl if needed). */
+static void kb_press(void) {
+    struct VKey vk = KBROWS[kb_r].k[kb_c];
+    if (vk.sh == 1) send_scancode(0x2A, 1);          /* LShift */
+    if (vk.sh == 2) send_scancode(0x1D, 1);          /* LCtrl  */
+    send_scancode(vk.sc, 1);
+    send_scancode(vk.sc, 0);
+    if (vk.sh == 1) send_scancode(0x2A, 0);
+    if (vk.sh == 2) send_scancode(0x1D, 0);
+}
+
+static void sf3000_poll_input(void) {
+    if (!cv_keys) return;
+    scq_drain1();   /* feed at most one queued scancode per frame */
+    static uint32_t prev = 0;
+    uint32_t k = *cv_keys;
+    /* SELECT (bit0) + START (bit3) edge -> open the main menu */
+    int ms_now = cvbtn(k,0) && cvbtn(k,3);
+    int ms_was = cvbtn(prev,0) && cvbtn(prev,3);
+    if (ms_now && !ms_was) { menu_visible = !menu_visible; kb_visible = dm_visible = 0; menu_sel = 0; prev = k; return; }
+
+    /* L (bit10) + R (bit11) edge -> on-screen keyboard quick toggle */
+    int lr_now = cvbtn(k,10) && cvbtn(k,11);
+    int lr_was = cvbtn(prev,10) && cvbtn(prev,11);
+    if (lr_now && !lr_was) { kb_visible = !kb_visible; menu_visible = dm_visible = 0; prev = k; return; }
+
+    if (menu_visible) {
+        int up=cvbtn(k,4)&&!cvbtn(prev,4), dn=cvbtn(k,6)&&!cvbtn(prev,6);
+        int lf=cvbtn(k,7)&&!cvbtn(prev,7), rt=cvbtn(k,5)&&!cvbtn(prev,5);
+        int a =cvbtn(k,13)&&!cvbtn(prev,13), b=cvbtn(k,14)&&!cvbtn(prev,14);
+        if (up) { if (--menu_sel < 0) menu_sel = MENU_N-1; }
+        if (dn) { if (++menu_sel >= MENU_N) menu_sel = 0; }
+        int act = a;
+        if (menu_sel == 4 && (lf||rt)) { mouse_sens += rt?1:-1; if(mouse_sens<1)mouse_sens=3; if(mouse_sens>3)mouse_sens=1; }
+        else if (menu_sel == 6 && (lf||rt)) { cpu_speed += rt?1:-1; if(cpu_speed<0)cpu_speed=2; if(cpu_speed>2)cpu_speed=0; exec_loops=CPU_LOOPS[cpu_speed]; }
+        else if (menu_sel == 7 && (lf||rt)) { frameskip += rt?1:-1; if(frameskip<0)frameskip=3; if(frameskip>3)frameskip=0; }
+        else if (act) {
+            switch (menu_sel) {
+                case 0: menu_visible = 0; break;
+                case 1: kb_visible = 1; menu_visible = 0; break;
+                case 2: if (disk_count > 0) { dm_visible = 1; dm_sel = disk_cur; menu_visible = 0; } break;
+                case 3: mouse_mode = !mouse_mode; if (mouse_mode) joystick_mode = 0; break;
+                case 4: if (++mouse_sens > 3) mouse_sens = 1; break;
+                case 5: joystick_mode = !joystick_mode; if (joystick_mode) mouse_mode = 0; break;
+                case 6: if (++cpu_speed > 2) cpu_speed = 0; exec_loops = CPU_LOOPS[cpu_speed]; break;
+                case 7: if (++frameskip > 3) frameskip = 0; break;
+                case 8: p286log("reset86 (menu)"); reset86(); menu_visible = 0; break;
+                case 9: p286log("exit (menu)"); exit(0); break;
+            }
+        }
+        if (b) menu_visible = 0;
+        prev = k;
+        return;
+    }
+
+    if (mouse_mode) {
+        static int held = 0; static uint8_t pb = 0;
+        int u=cvbtn(k,4), d=cvbtn(k,6), l=cvbtn(k,7), r=cvbtn(k,5);
+        held = (u||d||l||r) ? held+1 : 0;
+        int spd = (1 + held/4) * mouse_sens; if (spd > 24) spd = 24;
+        int dx = (r-l)*spd, dy = (d-u)*spd;
+        uint8_t buttons = (cvbtn(k,13)?1:0) | (cvbtn(k,14)?2:0);  /* A=left B=right */
+        if (dx || dy || buttons != pb) {
+            if (dx > 63) dx = 63; if (dx < -63) dx = -63;
+            if (dy > 63) dy = 63; if (dy < -63) dy = -63;
+            sermouseevent(buttons, (int8_t)dx, (int8_t)dy);
+        }
+        pb = buttons;
+        prev = k;
+        return;
+    }
+
+    if (joystick_mode) {
+        pc_joy_x = cvbtn(k,7) ? -100 : (cvbtn(k,5) ? 100 : 0);   /* left / right */
+        pc_joy_y = cvbtn(k,4) ? -100 : (cvbtn(k,6) ? 100 : 0);   /* up / down */
+        pc_joy_btn = (cvbtn(k,13)?1:0) | (cvbtn(k,14)?2:0);      /* A=btn1 B=btn2 */
+        prev = k;
+        return;
+    }
+
+    if (dm_visible) {
+        int up = cvbtn(k,4)&&!cvbtn(prev,4), dn = cvbtn(k,6)&&!cvbtn(prev,6);
+        int a  = cvbtn(k,13)&&!cvbtn(prev,13), b = cvbtn(k,14)&&!cvbtn(prev,14);
+        if (up) { if (--dm_sel < 0) dm_sel = disk_count-1; }
+        if (dn) { if (++dm_sel >= disk_count) dm_sel = 0; }
+        if (a) { p286log("swap B: -> %s rv=%d", disk_paths[dm_sel], insertdisk(1, disk_paths[dm_sel])); disk_cur = dm_sel; dm_visible = 0; }
+        if (b) dm_visible = 0;
+        prev = k;
+        return;
+    }
+
+    if (kb_visible) {
+        static int a_held = 0; static uint8_t held_sc = 0, held_sh = 0;
+        int a = cvbtn(k,13);
+        if (a && !a_held) {                       /* A down: queue make */
+            struct VKey vk = KBROWS[kb_r].k[kb_c];
+            if (vk.sh == 1) scq_push(0x2A, 1);     /* LShift */
+            if (vk.sh == 2) scq_push(0x1D, 1);     /* LCtrl  */
+            scq_push(vk.sc, 1);
+            held_sc = vk.sc; held_sh = vk.sh; a_held = 1;
+        } else if (!a && a_held) {                /* A up: queue break */
+            scq_push(held_sc, 0);
+            if (held_sh == 1) scq_push(0x2A, 0);
+            if (held_sh == 2) scq_push(0x1D, 0);
+            a_held = 0;
+        }
+        if (!a_held) {                            /* navigate only when not typing */
+            int up=cvbtn(k,4)&&!cvbtn(prev,4), dn=cvbtn(k,6)&&!cvbtn(prev,6);
+            int lf=cvbtn(k,7)&&!cvbtn(prev,7), rt=cvbtn(k,5)&&!cvbtn(prev,5);
+            int b =cvbtn(k,14)&&!cvbtn(prev,14);
+            if (up) { if (--kb_r < 0) kb_r = KB_NROWS-1; }
+            if (dn) { if (++kb_r >= KB_NROWS) kb_r = 0; }
+            if (kb_c >= KBROWS[kb_r].n) kb_c = KBROWS[kb_r].n - 1;
+            if (lf) { if (--kb_c < 0) kb_c = KBROWS[kb_r].n-1; }
+            if (rt) { if (++kb_c >= KBROWS[kb_r].n) kb_c = 0; }
+            if (b) kb_visible = 0;
+        }
+        prev = k;
+        return;
+    }
+
+    static const struct { int bit; uint8_t sc; } map[] = {
+        {4,0x48},{6,0x50},{7,0x4B},{5,0x4D},   /* up down left right */
+        {13,0x1C},{14,0x01},{12,0x39},{15,0x1D},/* A=Enter B=Esc X=Space Y=Ctrl */
+        {10,0x2A},{11,0x38},                    /* L=Shift R=Alt */
+        {3,0x1C},{0,0x0F},                      /* START=Enter SELECT=Tab */
+    };
+    for (unsigned i = 0; i < sizeof(map)/sizeof(map[0]); i++) {
+        int now = cvbtn(k, map[i].bit), was = cvbtn(prev, map[i].bit);
+        if (now && !was) send_scancode(map[i].sc, 1);
+        else if (!now && was) send_scancode(map[i].sc, 0);
+    }
+    prev = k;
+}
+
+/* Present SCREEN (XRGB8888 640x480) via the HW display (RGB565). */
+static void sf3000_present(void) {
+    /* renderer() fills only rows 0..399 (outer loop caps at y<400), so
+       letterbox: center those 400 rows in the 480-row panel (40px bars). */
+    const int ytop = (480 - 400) / 2; /* 40 */
+    memset(fb565, 0, ytop * 640 * sizeof(uint16_t));
+    memset(fb565 + (ytop + 400) * 640, 0, (480 - ytop - 400) * 640 * sizeof(uint16_t));
+    const uint32_t *s = SCREEN;
+    uint16_t *d = fb565 + ytop * 640;
+    for (int i = 0; i < 640 * 400; i++) {
+        uint32_t p = s[i];
+        d[i] = (uint16_t)(((p >> 19) & 0x1F) << 11 |
+                          ((p >> 10) & 0x3F) << 5  |
+                          ((p >> 3)  & 0x1F));
+    }
+    if (menu_visible) menu_draw();
+    if (kb_visible) kb_draw();
+    if (dm_visible) dm_draw();
+    if (mouse_mode && !menu_visible) kb_puts(8, 6, "MOUSE", 0x07E0, 0x0000);
+    if (joystick_mode && !menu_visible) kb_puts(8, 6, "JOY", 0xFFE0, 0x0000);
+    hwdisp_present(fb565, 640, 480, 640 * 2);
+}
+
+/* Crash/bring-up logging to the SD card (gated on log.txt existing). */
+static void p286log(const char *fmt, ...) {
+    FILE *f = fopen("/mnt/sdcard/log.txt", "a");
+    if (!f) return;
+    fprintf(f, "P286 ");
+    va_list ap; va_start(ap, fmt); vfprintf(f, fmt, ap); va_end(ap);
+    fputc('\n', f); fflush(f); fsync(fileno(f)); fclose(f);
+}
+
+int main(int argc, char **argv) {
+    signal(SIGINT, signal_handler);
+    signal(SIGTERM, signal_handler);
+    p286log("start argv1=%s", (argc > 1 && argv[1]) ? argv[1] : "(none)");
+
+    if (hwdisp_init() != 0) {
+        p286log("hwdisp_init FAILED");
+        return -1;
+    }
+    p286log("hwdisp_init ok");
+    fb1_clear();   /* hide battery/volume OSD during gameplay */
+    sf3000_input_init();
+
+    memset(SCREEN, 0, sizeof(SCREEN));
+    emu8950_opl = OPL_new(3579552, SOUND_FREQUENCY);
+    blaster_reset();
+    sn76489_reset();
+    p286log("opl+reset ok");
+
+    /* Disk image passed by FrogUI. Floppy images (<= 1.44MB: 360K/720K/1.2M/1.44M)
+     * go in drive A: (0); anything larger is treated as a hard disk (128). Wrong
+     * geometry can crash insertdisk, so size-detect rather than guess. */
+    if (argc > 1 && argv[1] && argv[1][0]) {
+        long sz = 0;
+        FILE *fd = fopen(argv[1], "rb");
+        if (fd) { fseek(fd, 0, SEEK_END); sz = ftell(fd); fclose(fd); }
+        p286log("disk %s size=%ld", argv[1], sz);
+        /* If a FreeDOS boot floppy is present in cubegm, boot it and mount the
+         * launched image as a DATA drive (floppy=B:, hard disk=C:); FreeDOS
+         * auto-runs RUN.BAT / first .EXE/.COM/.BAT on C: then B:. If FreeDOS is
+         * absent, boot the launched image directly (self-booting games). */
+        const char *fdpath = "/mnt/sdcard/cubegm/bios/x86BOOT.img";
+        FILE *ft = fopen(fdpath, "rb");
+        int have_fd = (ft != NULL); if (ft) fclose(ft);
+        if (have_fd) {
+            if (sz > 0 && sz <= 1474560) {
+                /* floppy game: scan the folder for all floppy images so the
+                 * built-in disk-swap menu (SELECT+START) can switch B: on the
+                 * fly. Boot with disk 1 (first in sorted order) in B:. */
+                disk_scan(argv[1]);
+                const char *first = disk_count > 0 ? disk_paths[0] : argv[1];
+                disk_cur = 0; dm_sel = 0;
+                p286log("game floppy B: (%d disks) rv=%d", disk_count, insertdisk(1, (char*)first));
+            } else {
+                p286log("game HDD C: rv=%d",   insertdisk(128, argv[1]));  /* C: */
+            }
+            p286log("boot FreeDOS A: (%s) rv=%d", fdpath, insertdisk(0, (char*)fdpath));
+        } else if (sz > 0 && sz <= 1474560) {
+            p286log("direct boot floppy A: rv=%d", insertdisk(0, argv[1]));
+        } else {
+            p286log("direct HDD C: rv=%d", insertdisk(128, argv[1]));
+        }
+    }
+
+    /* Wire the memory-access function pointers to the onboard-RAM variants
+     * (host has the RAM[] array; no PSRAM/swap). pico-main does this per memory
+     * mode; linux-main relied on it being done elsewhere. Without it the
+     * pointers are NULL and exec86 crashes on the first memory access. */
+    write86 = write86_ob; writew86 = writew86_ob; writedw86 = writedw86_ob;
+    read86  = read86_ob;  readw86  = readw86_ob;  readdw86  = readdw86_ob;
+    p286log("accessors wired (_ob)");
+
+    p286log("reset86...");
+    reset86();
+    p286log("reset86 ok, entering loop");
+
+    linux_audio_init(SOUND_FREQUENCY, 2, AUDIO_BUFFER_LENGTH);
+    linux_audio_start();
+
+    pthread_t sound_tid, ticks_tid;
+#ifndef P286_NOTHREADS
+    pthread_create(&sound_tid, NULL, sound_thread, NULL);
+    pthread_create(&ticks_tid, NULL, ticks_thread, NULL);
+#else
+    (void)sound_tid; (void)ticks_tid;
+    p286log("THREADS DISABLED (debug)");
+#endif
+
+    static int dbgframe = 0;
+    int fs_count = 0;
+    while (running) {
+        exec86(exec_loops);
+        if (dbgframe < 5) p286log("frame %d: post exec86", dbgframe);
+#ifdef P286_NOTHREADS
+        renderer();        /* drive video from main loop in single-thread debug */
+        if ((dbgframe & 15) == 0) doirq(0);   /* fake timer tick */
+#endif
+        sf3000_poll_input();
+        /* frame skip: present 1 of (frameskip+1) iterations so the CPU runs
+         * more between displays (menu overlays always show immediately). */
+        if (fs_count == 0 || menu_visible || kb_visible || dm_visible) sf3000_present();
+        if (++fs_count > frameskip) fs_count = 0;
+        if (dbgframe < 5) { p286log("frame %d: presented", dbgframe); dbgframe++; }
+    }
+
+#ifndef P286_NOTHREADS
+    pthread_cancel(sound_tid);
+    pthread_cancel(ticks_tid);
+    pthread_join(sound_tid, NULL);
+    pthread_join(ticks_tid, NULL);
+#endif
+    linux_audio_close();
+    hwdisp_deinit();
+    return 0;
+}
