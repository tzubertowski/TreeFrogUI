diff --git a/port_sf3000/build.sh b/port_sf3000/build.sh
new file mode 100755
index 0000000..80535ab
--- /dev/null
+++ b/port_sf3000/build.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Build the pico286 standalone DOS/PC emulator for SF3000/R36SX (MIPS 74Kc).
+# Self-locating: resolves the pico-286 source root from this script's location.
+set -e
+cd "$(cd "$(dirname "$0")/.." && pwd)"
+TC="$HOME/sf3000-work/sf3000toolchain/mipsel-buildroot-linux-gnu_sdk-buildroot"
+MIPS="$TC/opt/ext-toolchain/bin/mips-mti-linux-gnu-"
+SYSROOT="$TC/mipsel-buildroot-linux-gnu/sysroot"
+A="-mips32r2 -march=mips32r2 -mtune=74kc -mdspr2 -mfp32 -mhard-float -mlong-calls -fms-extensions -EL --sysroot=$SYSROOT -O2 -w -DUSE_EMU8950_OPL=1 -DEMU8950_SLOT_RENDER=1 -DEMU8950_NO_RATECONV=1 -DEMU8950_NO_WAVE_TABLE_MAP=1 -DEMU8950_NO_TLL=1 -DEMU8950_NO_FLOAT=1 -DEMU8950_NO_TIMER=1 -DEMU8950_NO_TEST_FLAG=1 -DEMU8950_SIMPLER_NOISE=1 -DEMU8950_SHORT_NOISE_UPDATE_CHECK=1 -DEMU8950_LINEAR_SKIP=1 -DEMU8950_LINEAR_END_OF_NOTE_OPTIMIZATION -DEMU8950_NO_PERCUSSION_MODE=1 -DEMU8950_LINEAR=1"
+INC="-Isrc -Isrc/emulator -Isrc/emulator/includes -Isrc/emu8950 -Ifindfirst -Iport_sf3000"
+rm -rf /tmp/p286; mkdir -p /tmp/p286; OBJ=""
+cc()  { "${MIPS}gcc" $A -std=gnu11   $INC -c "$1" -o "$2"; }
+cxx() { "${MIPS}g++" $A -std=gnu++14 $INC -c "$1" -o "$2"; }
+n=0
+for f in $(find src/emulator src/emu8950 -name "*.c") src/printf/printf.c findfirst/findfirst.c findfirst/spec.c port_sf3000/host_stubs.c; do
+  o=/tmp/p286/c$n.o; cc "$f" "$o"; OBJ="$OBJ $o"; n=$((n+1))
+done
+for f in $(find src/emulator src/emu8950 -name "*.cpp") port_sf3000/sf3000-main.cpp; do
+  o=/tmp/p286/x$n.o; cxx "$f" "$o"; OBJ="$OBJ $o"; n=$((n+1))
+done
+# hwdisp.c is C
+o=/tmp/p286/hwdisp.o; cc port_sf3000/hwdisp.c "$o"; OBJ="$OBJ $o"
+echo "=== link ==="
+"${MIPS}g++" $A $INC $OBJ -o pico286 -L"$SYSROOT/usr/lib" -lpthread -ldl -lm -lc
+"${MIPS}strip" pico286
+ls -la pico286; file pico286 | cut -d, -f1-2
