+/* Map joy_key buttons to PC keys (edge-detected). Dpad = arrows, A = Enter,
+ * B = Esc, X = Space, Y = Ctrl, START = Enter, SELECT = Tab. (On-screen
+ * keyboard for full text input comes next.) */
+/* ---------------- On-screen keyboard (for DOS / typing commands) ----------------
+ * Toggle: hold L + R together. While open, the D-pad moves the cursor, A presses
+ * the highlighted key, B closes. Game input is suspended while the KB is open. */
+struct VKey { const char *l; uint8_t sc; uint8_t sh; };
+static const struct { int n; struct VKey k[12]; } KBROWS[] = {
+    {12,{{"1",0x02},{"2",0x03},{"3",0x04},{"4",0x05},{"5",0x06},{"6",0x07},{"7",0x08},{"8",0x09},{"9",0x0A},{"0",0x0B},{"-",0x0C},{"=",0x0D}}},
+    {11,{{"Q",0x10},{"W",0x11},{"E",0x12},{"R",0x13},{"T",0x14},{"Y",0x15},{"U",0x16},{"I",0x17},{"O",0x18},{"P",0x19},{"\\",0x2B}}},
+    {10,{{"A",0x1E},{"S",0x1F},{"D",0x20},{"F",0x21},{"G",0x22},{"H",0x23},{"J",0x24},{"K",0x25},{"L",0x26},{":",0x27,1}}},
+    {9, {{"Z",0x2C},{"X",0x2D},{"C",0x2E},{"V",0x2F},{"B",0x30},{"N",0x31},{"M",0x32},{".",0x34},{"/",0x35}}},
+    {6, {{"SPC",0x39},{"ENT",0x1C},{"BSP",0x0E},{"ESC",0x01},{"TAB",0x0F},{"^C",0x2E,2}}},
+};
+#define KB_NROWS ((int)(sizeof(KBROWS)/sizeof(KBROWS[0])))
+static int kb_visible = 0, kb_r = 0, kb_c = 0;
+
+/* Virtual mouse: D-pad moves, A=left, B=right. Feeds the emulated COM1 serial
+ * mouse (needs a DOS mouse driver loaded, e.g. CTMOUSE, for INT33 games). */
+extern "C" void sermouseevent(uint8_t buttons, int8_t xrel, int8_t yrel);
+static int mouse_mode = 0;
+static int mouse_sens = 2;            /* 1..3 cursor speed multiplier */
+
+/* Virtual joystick -> emulated PC game port (0x201). */
+extern "C" { extern int8_t pc_joy_x, pc_joy_y; extern uint8_t pc_joy_btn; }
+static int joystick_mode = 0;
+
+/* Frame skip: render+present 1 of (frameskip+1) frames to give the CPU more time. */
+static int frameskip = 0;
+
+/* Main menu (SELECT+START). exec_loops = CPU instructions per frame (speed). */
+static int menu_visible = 0, menu_sel = 0;
+static uint32_t exec_loops = 32768;
+static int cpu_speed = 1;             /* 0 slow, 1 normal, 2 fast */
+static const uint32_t CPU_LOOPS[3] = { 16384, 32768, 49152 };
+#define MENU_N 10
+
+/* ---- Disk-swap menu: list of floppy .img files in the game's folder ---- */
+#define DISK_MAX 24
+static char disk_dir[512];
+static char disk_names[DISK_MAX][128];
+static char disk_paths[DISK_MAX][640];
+static int  disk_count = 0, disk_cur = 0;
+static int  dm_visible = 0, dm_sel = 0;
+
+static int has_img_ext(const char *n) {
+    const char *d = strrchr(n, '.');
+    return d && (!strcasecmp(d, ".img") || !strcasecmp(d, ".ima") || !strcasecmp(d, ".vfd"));
+}
+/* Scan the directory of `path` for sibling floppy images (sorted). */
+static void disk_scan(const char *path) {
+    disk_count = 0; disk_cur = 0;
+    strncpy(disk_dir, path, sizeof(disk_dir)-1);
+    char *sl = strrchr(disk_dir, '/');
+    if (!sl) { disk_dir[0] = '.'; disk_dir[1] = 0; } else *sl = 0;
+    DIR *d = opendir(disk_dir);
+    if (!d) return;
+    struct dirent *e;
+    while ((e = readdir(d)) && disk_count < DISK_MAX) {
+        if (e->d_name[0] == '.') continue;
+        if (!has_img_ext(e->d_name)) continue;
+        snprintf(disk_paths[disk_count], sizeof(disk_paths[0]), "%s/%s", disk_dir, e->d_name);
+        strncpy(disk_names[disk_count], e->d_name, sizeof(disk_names[0])-1);
+        disk_count++;
+    }
+    closedir(d);
+    /* simple insertion sort by name so disk1, disk2, ... come in order */
+    for (int i = 1; i < disk_count; i++)
+        for (int j = i; j > 0 && strcasecmp(disk_names[j-1], disk_names[j]) > 0; j--) {
+            char tn[128], tp[640];
+            strcpy(tn, disk_names[j]); strcpy(disk_names[j], disk_names[j-1]); strcpy(disk_names[j-1], tn);
+            strcpy(tp, disk_paths[j]); strcpy(disk_paths[j], disk_paths[j-1]); strcpy(disk_paths[j-1], tp);
+        }
+    /* mark which one matches the launched path as current */
+    for (int i = 0; i < disk_count; i++)
+        if (!strcmp(disk_paths[i], path)) { disk_cur = i; dm_sel = i; break; }
+}
+
+static inline void kb_putc(int x, int y, char c, uint16_t fg, uint16_t bg) {
+    const unsigned char *g = &font_8x8[(uint8_t)c * 8];
+    for (int row = 0; row < 8; row++) {
+        uint8_t bits = g[row];
+        for (int col = 0; col < 8; col++) {
+            uint16_t p = (bits >> col & 1) ? fg : bg;
+            for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
+                int px = x + col*2 + dx, py = y + row*2 + dy;
+                if ((unsigned)px < 640 && (unsigned)py < 480) fb565[py*640+px] = p;
+            }
+        }
+    }
+}
+static inline void kb_puts(int x, int y, const char *s, uint16_t fg, uint16_t bg) {
+    for (; *s; s++, x += 14) kb_putc(x, y, *s, fg, bg);
+}
+
+/* Scancode queue drained one entry per video frame, so every make/break gets
+ * its own serviced IRQ1 (sending make+break in one frame coalesces the IRQ and
+ * the guest sees nothing / a stuck key). */
+static uint8_t scq_sc[64]; static uint8_t scq_dn[64]; static int scq_h = 0, scq_t = 0;
+static void scq_push(uint8_t sc, int dn) { int n = (scq_t + 1) & 63; if (n != scq_h) { scq_sc[scq_t] = sc; scq_dn[scq_t] = dn; scq_t = n; } }
+static void scq_drain1(void) { if (scq_h != scq_t) { send_scancode(scq_sc[scq_h], scq_dn[scq_h]); scq_h = (scq_h + 1) & 63; } }
+
+/* Draw the keyboard overlay into fb565 (called from present when visible). */
+static void kb_draw(void) {
+    const uint16_t PANEL = 0x10A2, FG = 0xFFFF, HLBG = 0xFD20, HLFG = 0x0000,
+                   BORD = 0x4A69, KEYBG = 0x2104;
+    const int cellw = 52, cellh = 28, x0 = 4, y0 = 480 - (KB_NROWS*cellh) - 8;
+    for (int yy = y0 - 6; yy < 480; yy++)
+        for (int xx = 0; xx < 640; xx++) fb565[yy*640+xx] = PANEL;
+    for (int r = 0; r < KB_NROWS; r++) {
+        for (int c = 0; c < KBROWS[r].n; c++) {
+            int x = x0 + c*cellw, y = y0 + r*cellh, w = cellw - 3, h = cellh - 3;
+            int sel = (r == kb_r && c == kb_c);
+            uint16_t bg = sel ? HLBG : KEYBG, fg = sel ? HLFG : FG;
+            for (int yy = y; yy < y + h && yy < 480; yy++)
+                for (int xx = x; xx < x + w && xx < 640; xx++) {
+                    int edge = (yy == y || yy == y+h-1 || xx == x || xx == x+w-1);
+                    fb565[yy*640+xx] = edge ? BORD : bg;
+                }
+            kb_puts(x + 5, y + 6, KBROWS[r].k[c].l, fg, bg);
+        }
+    }
+}
+
+/* Draw the disk-swap menu overlay into fb565. */
+static void dm_draw(void) {
+    const uint16_t BG = 0x10A2, FG = 0xFFFF, HLBG = 0x07E0, HLFG = 0x0000;
+    const int x0 = 40, y0 = 70, w = 560, rowh = 22;
+    int bot = y0 + disk_count*rowh + 8; if (bot > 480) bot = 480;
+    for (int yy = y0 - 24; yy < bot; yy++)
+        if ((unsigned)yy < 480) for (int xx = 20; xx < 620; xx++) fb565[yy*640+xx] = BG;
+    kb_puts(x0, y0 - 18, "DISK  A:INSERT B:  B:CLOSE", FG, BG);
+    for (int i = 0; i < disk_count; i++) {
+        int y = y0 + i*rowh, sel = (i == dm_sel);
+        uint16_t fg = sel ? HLFG : FG, bg = sel ? HLBG : BG;
+        if (sel) for (int yy = y; yy < y+rowh-2 && yy < 480; yy++)
+            for (int xx = x0-4; xx < x0+w && xx < 640; xx++) fb565[yy*640+xx] = bg;
+        char line[140];
+        snprintf(line, sizeof line, "%c %s", i == disk_cur ? '*' : ' ', disk_names[i]);
+        kb_puts(x0, y, line, fg, bg);
+    }
+}
+
+/* Build the label for main-menu row i into buf. */
+static void menu_label(int i, char *buf, int n) {
+    static const char *cpu[3] = { "SLOW", "NORMAL", "FAST" };
+    switch (i) {
+        case 0: snprintf(buf, n, "RESUME"); break;
+        case 1: snprintf(buf, n, "KEYBOARD"); break;
+        case 2: if (disk_count > 0) snprintf(buf, n, "DISK: %s", disk_names[disk_cur]);
+                else snprintf(buf, n, "DISK: (none)"); break;
+        case 3: snprintf(buf, n, "MOUSE MODE: %s", mouse_mode ? "ON" : "OFF"); break;
+        case 4: snprintf(buf, n, "MOUSE SPEED: %d", mouse_sens); break;
+        case 5: snprintf(buf, n, "JOYSTICK: %s", joystick_mode ? "ON" : "OFF"); break;
+        case 6: snprintf(buf, n, "CPU SPEED: %s", cpu[cpu_speed]); break;
+        case 7: snprintf(buf, n, "FRAME SKIP: %d", frameskip); break;
+        case 8: snprintf(buf, n, "RESET (REBOOT)"); break;
+        case 9: snprintf(buf, n, "EXIT TO MENU"); break;
+        default: buf[0] = 0;
+    }
+}
