+{
+    if (fd < 1 || fd > 8 || !qpsx_dirs[fd - 1]) return -1;
+    struct dirent *entry = readdir(qpsx_dirs[fd - 1]);
+    if (!entry) return -1;
+    strcpy((char *)buf + 4, entry->d_name);
+    strcpy((char *)buf + 0x22, entry->d_name);
+    return 1;
+}
+extern "C" int fs_closedir(int fd)
+{
+    if (fd < 1 || fd > 8 || !qpsx_dirs[fd - 1]) return -1;
+    closedir(qpsx_dirs[fd - 1]);
+    qpsx_dirs[fd - 1] = NULL;
+    return 0;
