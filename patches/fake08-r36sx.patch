diff --git a/source/cxx17compat.h b/source/cxx17compat.h
new file mode 100644
index 0000000..36714c2
--- /dev/null
+++ b/source/cxx17compat.h
@@ -0,0 +1,29 @@
+#pragma once
+/* C++17 library bits missing from the GCC 6.3 (Codescape) libstdc++ used to
+ * build for the R36SX/SF3000. Provides std::string_view and std::clamp so the
+ * upstream fake-08 sources compile unchanged on this toolchain. */
+#include <algorithm>
+
+#if defined(__cpp_lib_string_view)
+#include <string_view>
+#else
+#include <experimental/string_view>
+namespace std {
+    using experimental::basic_string_view;
+    using experimental::string_view;
+    using experimental::u16string_view;
+    using experimental::u32string_view;
+    using experimental::wstring_view;
+}
+#endif
+
+#if !defined(__cpp_lib_clamp)
+namespace std {
+    template<class T> constexpr const T& clamp(const T& v, const T& lo, const T& hi) {
+        return v < lo ? lo : (hi < v ? hi : v);
+    }
+    template<class T, class C> constexpr const T& clamp(const T& v, const T& lo, const T& hi, C comp) {
+        return comp(v, lo) ? lo : (comp(hi, v) ? hi : v);
+    }
+}
+#endif
