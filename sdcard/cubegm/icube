#!/bin/sh
LOG=/mnt/sdcard/frogui.log
ICUBE_LOG=/mnt/sdcard/icube.log
# Rotate previous log so we don't lose evidence after reboot
[ -f "$LOG" ] && mv "$LOG" "$LOG.prev"
> "$LOG"
echo "=== icube boot $(date '+%H:%M:%S' 2>/dev/null) ===" >> "$ICUBE_LOG"

export LD_LIBRARY_PATH=/mnt/sdcard/cubegm/lib:/mnt/sdcard/cubegm/usr/lib:$LD_LIBRARY_PATH

if ! pidof cubevol > /dev/null 2>&1; then
    echo "starting cubevol..." >> "$LOG"
    /usr/bin/cubevol &
    sleep 0.3
fi

PICOARCH=/mnt/sdcard/cubegm/picoarch
FROGUI_CORE=/mnt/sdcard/cubegm/cores/frogui_libretro.so
# picoarch needs a ROM arg even for no-game cores — pass dummy (core ignores it)
DUMMY=/mnt/sdcard/cubegm/cores/frogui_libretro.so
LAUNCH=/tmp/frogui_launch.txt

# Run mmap exec test once if binary present (remove binary to disable)
MMAP_TEST=/mnt/sdcard/cubegm/mmap_exec_test
if [ -f "$MMAP_TEST" ]; then
    chmod +x "$MMAP_TEST"
    echo "=== mmap_exec_test ===" >> /mnt/sdcard/mmap_test.log
    "$MMAP_TEST" >> /mnt/sdcard/mmap_test.log 2>&1
    echo "exit=$?" >> /mnt/sdcard/mmap_test.log
fi

ITER=0
while true; do
    ITER=$((ITER+1))
    rm -f "$LAUNCH"
    killall rkgame 2>/dev/null
    echo "iter $ITER: launching picoarch+frogui" >> "$ICUBE_LOG"
    echo "launching FrogUI..." >> "$LOG"
    [ -f /mnt/sdcard/lastrun.log.prev ] && mv -f /mnt/sdcard/lastrun.log.prev /mnt/sdcard/lastrun.log.prev2
    [ -f /mnt/sdcard/lastrun.log ] && mv -f /mnt/sdcard/lastrun.log /mnt/sdcard/lastrun.log.prev
    "$PICOARCH" "$FROGUI_CORE" "$DUMMY" > /mnt/sdcard/lastrun.log 2>&1
    RC=$?
    echo "iter $ITER: picoarch exited rc=$RC" >> "$ICUBE_LOG"
    echo "picoarch/frogui exited: $RC" >> "$LOG"

    if [ -f "$LAUNCH" ]; then
        CORE_PATH=$(sed -n '1p' "$LAUNCH")
        ROM_PATH=$(sed -n '2p' "$LAUNCH")
        rm -f "$LAUNCH"
        echo "iter $ITER: launch file read core=[$CORE_PATH] rom=[$ROM_PATH]" >> "$ICUBE_LOG"
        if [ -n "$CORE_PATH" ] && [ -n "$ROM_PATH" ]; then
            killall rkgame 2>/dev/null; sleep 0.3
            echo "iter $ITER: launching game" >> "$ICUBE_LOG"
            "$PICOARCH" "$CORE_PATH" "$ROM_PATH" > /mnt/sdcard/game.log 2>&1
            GAME_RC=$?
            echo "iter $ITER: game exited rc=$GAME_RC" >> "$ICUBE_LOG"
        fi
    else
        echo "iter $ITER: no launch file found" >> "$ICUBE_LOG"
    fi
    sleep 0.2
done
